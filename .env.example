# Copy to .env locally and never commit it. On Render, use Secret Environment Variables.
# Rotate all previously exposed credentials on the provider before configuring these.
DELTA_MSSQL_SERVER=
DELTA_MSSQL_PORT=1433
DELTA_MSSQL_DATABASE=
DELTA_MSSQL_USER=
DELTA_MSSQL_PASSWORD=
DELTA_MSSQL_ENCRYPT=true
DELTA_MSSQL_TRUST_SERVER_CERTIFICATE=false

# SQL Server read-only API is a separate deployment mode; do not confuse
# successful SQL connection health with live SQL Server booking writes.
# THAM_SQLSERVER_CATALOG_API_URL=
