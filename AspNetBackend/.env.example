# Set via hosting secret manager, NEVER commit real credentials.
SQLSERVER_CONNECTION_STRING=Server=tcp:YOUR_SQL_HOST,1433;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_SECRET;Encrypt=True;TrustServerCertificate=False;Connection Timeout=10;
# Shared data-protection keys persist auth cookie across redeploys (mount a secure volume).
DATA_PROTECTION_KEYS_PATH=/var/delta-travel-keys